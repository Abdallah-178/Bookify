@model BookFormViewModel


@{
    ViewData["Title"] = "Book Form";
}


<div class="card shadow-sm">
    <div class="card-header">
        <h3 class="card-title">
            @(Model?.id > 0 ? "Edit" : "Create") Book
        </h3>
    </div>
    <div class="card-body pt-0">
        <form method="post" asp-controller="Books" enctype="multipart/form-data">

            @if (Model?.id > 0)
            {
                <input type="hidden" asp-for="id" />
            }


            <div class="mb-10 mt-10">
                <!--begin::Image input-->
                <div class="image-input image-input-empty " data-kt-image-input="true" style="background-image: url(/assets/images/Books/@(string.IsNullOrEmpty(Model.ImageUrl) ? "no_img.png" : $"{Model.custom_img}"))">
                    <!--begin::Image preview wrapper-->
                    <div class="image-input-wrapper w-125px h-200px"></div>
                    <!--end::Image preview wrapper-->
                    <!--begin::Edit button-->
                    <label class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                           data-kt-image-input-action="change"
                           data-bs-dismiss="click">
                        <i class="bi bi-pencil-fill fs-7"></i>

                        <!--begin::Inputs-->
                        <input type="file" asp-for="Image" accept=".png, .jpg, .jpeg" />
                        <input type="hidden" name="avatar_remove" />
                        <!--end::Inputs-->
                    </label>
                    <!--end::Edit button-->
                    <!--begin::Cancel button-->
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="cancel"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                    <!--end::Cancel button-->
                    <!--begin::Remove button-->
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="remove"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                    <!--end::Remove button-->
                </div>
                <div class="form-text">Allowed File Types : png , jpg ,jpeg and connect be more than 2 MB</div>
                <span asp-validation-for="Image" class="text-danger d-block"></span>
                <!--end::Image input-->
          </div>


            <div class="row">
                <div class="col-md-5">
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3 mt-5">
                                <input type="text" class="form-control form-control-solid" asp-for="Title">
                                <label asp-for="Title"></label>
                            </div>
                            <span asp-validation-for="Title" class="text-danger d-block"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3 mt-5">
                                <select class="form-select form-select-solid js-select2" data-placeholder="Select Author" asp-for="AuthorId" asp-items="@Model.Authors">
                                    <option value="">Select Author</option>
                                </select>
                                <span asp-validation-for="AuthorId" class="text-danger d-block"></span>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3 mt-5">
                                <input type="text" class="form-control form-control-solid" asp-for="Publisher">
                                <label asp-for="Publisher"></label>
                            </div>
                            <span asp-validation-for="Publisher" class="text-danger d-block"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3 mt-5">
                                <input type="text" class="form-control form-control-solid form-control form-control-solid-solid js-datepicker" placeholder="Pick date rage" asp-for="PublishingDate">
                                <label asp-for="PublishingDate"></label>
                            </div>
                            <span asp-validation-for="PublishingDate" class="text-danger d-block"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3 mt-5">
                                <select class="form-select form-select-solid js-select2" data-placeholder="Select Categories" asp-for="SelectedCategories" asp-items="@Model.Categories">
                                    <option value="">Select Author</option>
                                </select>
                                <span asp-validation-for="SelectedCategories" class="text-danger d-block"></span>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-check form-switch mb-3 mt-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsAvilableForRentel">
                                <label class="form-check-label" asp-for="IsAvilableForRentel">

                                </label>
                            </div>
                            <span asp-validation-for="IsAvilableForRentel" class="text-danger d-block"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3 mt-5">
                                <input type="text" class="form-control form-control-solid" asp-for="Hall">
                                <label asp-for="Hall"></label>
                            </div>
                            <span asp-validation-for="Hall" class="text-danger d-block"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="row">
                        <div class="col-md-0">
                            <div class="form-check mb-3 mt-5">
                                <textarea asp-for="Description" class="tox-target js-tinymce"></textarea>

                            </div>
                            <span asp-validation-for="Description" class="text-danger d-block"></span>
                        </div>
                    </div>
                </div>
            </div>





            <button type="submit" class="btn btn-primary">
                <span class="indicator-label">
                    Save
                </span>
                <span class="indicator-progress">
                    Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                </span>
            </button>
        </form>
    </div>
</div>


@section Scripts {

    <script src="~/assets/tinymce/tinymce.bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />
}

