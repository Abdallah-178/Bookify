@model BookCopyFormViewModel


 <form asp-action="@(Model?.id > 0 ? "Edit" : "Create")"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="onModalBegin"
      data-ajax-success="@(Model?.id > 0 ? "onEditCopySuccess" : "onCreateCopySuccess")" 
      data-ajax-failure="onModalfailure"
      data-ajax-complete="showErrorComplete">


    <input type="hidden" asp-for="BookId" />

    @if (Model?.id > 0)
    {
        <input type="hidden" asp-for="id" />
    }

    <div class="form-floating mb-7 pb-1">
        <input  type="text"  asp-for="EditionNumber" class="form-control" value="@(Model.id > 0 ?Model.EditionNumber :"" )" />
        <label asp-for="EditionNumber"></label>
        <span asp-validation-for="EditionNumber" class="text-danger d-block"></span>
    </div>

    @if (Model!.ShowRentalOption)
        {
        <div class="form-check form-switch mb-3 mt-5">
            <input class="form-check-input" type="checkbox" asp-for="IsAvailableForRental">
            <label class="form-check-label" asp-for="IsAvailableForRental">
            </label>
        </div>
        <span asp-validation-for="IsAvailableForRental" class="text-danger d-block"></span>
        }

    <partial name="_ModelFooter" />
</form> 


 
