@model ResetPasswordFormViewModel



<form asp-controller="Users" 
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="onModalBegin"
      data-ajax-success="onModalSuccess"
      data-ajax-failure="onModalfailure"
      data-ajax-complete="showErrorComplete">

   
        <input type="hidden" asp-for="Id" />
    
    
    <div class="form-floating form-floating-solid mb-7 pb-1">
        <input type="password" asp-for="Password" class="form-control" autocomplete="off" />
        <label asp-for="Password"></label>
        <span asp-validation-for="Password" class="text-danger d-block"></span>
    </div>

    <div class="form-floating form-floating-solid mb-7 pb-1">
        <input type="password" asp-for="ConfirmPassword" class="form-control" autocomplete="off" />
        <label asp-for="ConfirmPassword"></label>
        <span asp-validation-for="ConfirmPassword" class="text-danger d-block"></span>
    </div>


    <partial name="_ModelFooter" />


</form>
